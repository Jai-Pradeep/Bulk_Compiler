; ── Three-Address IR ──────────────────────────────────────────────
; Format:  result = arg1 OP arg2  [type]
; Cast:    dest   = (toType) src   [srcType->toType]
; Types:   i32 / i64 / i128
; ─────────────────────────────────────────────────────────────────

    // PARALLEL LOOP [0..4999999]  -- no loop-carried dependencies, SIMD/thread-safe
    i_L1 = 0  [i32]
L1:
    t3 = i_L1 < 5000000  [i32]
    if t3 == 0 goto L2
    t4 = a[i_L1] + b[i_L1]  [i32]
    c[i_L1] = t4  [i32]
    t5 = i_L1 + 1  [i32]
    i_L1 = t5  [i32]
    goto L1
L2:
