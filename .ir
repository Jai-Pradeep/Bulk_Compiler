; ── Three-Address IR ──────────────────────────────────────────────
; Format:  result = arg1 OP arg2  [type]
; Cast:    dest   = (toType) src   [srcType->toType]
; Types:   i32 / i64 / i128
; ─────────────────────────────────────────────────────────────────

    t1 = a[i] + b[i]  [i32]
    c[i] = t1  [i32]
    // PARALLEL LOOP — fully parallel, all iterations independent [SIMD/multi-thread safe]
    //   parallel array: c[i]
    i = 0  [i32]
L2:
    t4 = i < 1000  [i32]
    if t4 == 0 goto L3
    t5 = a[i] + b[i]  [i32]
    c[i] = t5  [i32]
    t6 = i + 1  [i32]
    i = t6  [i32]
    goto L2
L3:
